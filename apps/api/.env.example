# Run the API from apps/api. These paths are relative to that working directory.
LLM_LAB_DEVICE=auto
LLM_LAB_AUTO_LOAD=true
LLM_LAB_MAX_INPUT_TOKENS=128
LLM_LAB_MAX_PROMPT_CHARACTERS=8192
LLM_LAB_QUEUE_CAPACITY=3
# Extra capture tensor peak cap: retained snapshots plus conservative working storage.
LLM_LAB_TRACE_MAX_BYTES=268435456
# Absolute TTL after completion, unique retained storage, and bounded HTTP JSON.
LLM_LAB_TRACE_TTL_SECONDS=1800
LLM_LAB_TRACE_STORE_MAX_BYTES=536870912
LLM_LAB_TRACE_STORE_MAX_ENTRIES=1024
LLM_LAB_TRACE_API_MAX_ELEMENTS=65536
LLM_LAB_TRACE_API_MAX_RESPONSE_BYTES=1048576
LLM_LAB_TRACE_SWEEP_SECONDS=15
# Stage 8 cache-disabled autoregressive generation bounds.
LLM_LAB_GENERATION_MAX_NEW_TOKENS=16
LLM_LAB_GENERATION_MAX_PREFIX_TOKENS=64
LLM_LAB_GENERATION_MAX_SESSIONS=16
LLM_LAB_GENERATION_MAX_INFLIGHT=2
LLM_LAB_GENERATION_MAX_TRACES=4
LLM_LAB_GENERATION_SESSION_MAX_BYTES=1048576
LLM_LAB_GENERATION_STATE_MAX_BYTES=16777216
LLM_LAB_GENERATION_TRACE_MAX_BYTES=33554432
LLM_LAB_GENERATION_SCRATCH_MAX_BYTES=33554432
LLM_LAB_GENERATION_DURATION_SECONDS=120
LLM_LAB_GENERATION_TTL_SECONDS=600
LLM_LAB_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LLM_LAB_CACHE_DIR=../../.cache/huggingface/hub
LLM_LAB_MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
